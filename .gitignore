# but surface Worldloom runtime additions that tracked dist modules import.
dist/*
!dist/worldloom/
dist/worldloom/*
!dist/worldloom/src/
dist/worldloom/src/*
!dist/worldloom/src/hanging-leaves.js
!dist/worldloom/assets/
dist/worldloom/assets/*
!dist/worldloom/assets/environment/
dist/worldloom/assets/environment/*
!dist/worldloom/assets/environment/hanging-tree-leaves-atlas.png
!dist/worldloom/assets/environment/hanging-tree-leaves.glb
.DS_Store
.env
.env.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.idea/
.vscode/
users.json
accounts.json
accounts.json.tmp
!.env.example
